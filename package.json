{
  "name": "teleiptv",
  "version": "2.1.9",
  "private": true,
  "description": "TeleIPTV - one web codebase, two builds: webOS (.ipk) and Android / Fire TV (.apk).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "serve:docs": "npx http-server docs -p 8090 -c-1",
    "bump": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "publish": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "notes": "node scripts/release-notes.js",
    "build:webos": "powershell -ExecutionPolicy Bypass -File scripts/build-webos.ps1",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:seek": "node scripts/test-seek-logic.js",
    "test:update": "node scripts/test-update-check.js",
    "test:ui": "node scripts/test-ui-scale.js",
    "test:pick": "node scripts/test-file-picker.js",
    "test:nav": "node scripts/test-navigation.js",
    "test:splash": "node scripts/test-splash.js",
    "test:notes": "node scripts/test-release-notes.js",
    "test": "npm run test:seek && npm run test:update && npm run test:ui && npm run test:pick && npm run test:nav && npm run test:splash && npm run test:notes",
    "build:all": "npm run build:webos && npm run build:android",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "http-server": "^14.1.1"
  }
}
